<view class="wm-page">
  <view class="compat-tip">
    <view>从图片里读出隐藏的图案水印，支持查看任意位平面和隐写检测。</view>
    <view style="font-weight: bold">声明: 图片全部在本地处理，不上传任何服务器，页面打开后断网也能用。这只是演示功能，实际的隐写技术可能更复杂和高级。</view>
  </view>

  <view class="panel">
    <view class="media-card" bindtap="chooseImage">
      <view class="media-card-head">
        <view>
          <view class="media-title">选择图片</view>
          <view class="media-tip">{{imageInfo || '从相册或聊天记录选一张带隐藏水印的图'}}</view>
        </view>
        <view class="media-actions">
          <button class="small-btn ghost" catchtap="chooseImage">{{hasImage ? '换一张' : '选择'}}</button>
          <button wx:if="{{hasImage}}" class="small-btn ghost" catchtap="previewImage">预览</button>
        </view>
      </view>
      <view class="media-box small">
        <image wx:if="{{imagePath}}" class="media-image" src="{{imagePath}}" mode="aspectFit" />
        <view wx:else class="empty">点这里选图片</view>
      </view>
    </view>
    <view wx:if="{{imageWarn}}" class="mode-tip">{{imageWarn}}</view>
  </view>

  <!-- 位平面查看 -->
  <view wx:if="{{hasImage}}" class="panel">
    <view class="section-title">位平面查看</view>
    <view class="field">
      <view class="field-label">通道</view>
      <view class="chip-row">
        <view class="chip {{planeChannel === 'r' ? 'on' : ''}}" data-field="planeChannel" data-value="r" bindtap="pickOption">红 R</view>
        <view class="chip {{planeChannel === 'g' ? 'on' : ''}}" data-field="planeChannel" data-value="g" bindtap="pickOption">绿 G</view>
        <view class="chip {{planeChannel === 'b' ? 'on' : ''}}" data-field="planeChannel" data-value="b" bindtap="pickOption">蓝 B</view>
        <view class="chip {{planeChannel === 'gray' ? 'on' : ''}}" data-field="planeChannel" data-value="gray" bindtap="pickOption">灰度</view>
        <view class="chip {{planeChannel === 'rgb' ? 'on' : ''}}" data-field="planeChannel" data-value="rgb" bindtap="pickOption">RGB 叠加</view>
      </view>
    </view>
    <view class="field">
      <view class="field-label">第几位</view>
      <view class="chip-row">
        <view wx:for="{{[0,1,2,3,4,5,6,7]}}" wx:key="*this" class="chip small {{planeBit === item ? 'on' : ''}}"
          data-field="planeBit" data-value="{{item}}" bindtap="pickOption">{{item}}</view>
      </view>
    </view>
    <view class="field">
      <view class="field-label">显示模式</view>
      <view class="chip-row">
        <view class="chip {{planeMode === 'bw' ? 'on' : ''}}" data-field="planeMode" data-value="bw" bindtap="pickOption">黑白</view>
        <view class="chip {{planeMode === 'amplify' ? 'on' : ''}}" data-field="planeMode" data-value="amplify" bindtap="pickOption">放大</view>
      </view>
    </view>
    <view class="switch-row">
      <view class="switch-cell">
        <text>反色</text>
        <switch checked="{{planeInvert}}" data-field="planeInvert" bindchange="onSwitch" color="#0f766e" />
      </view>
    </view>
    <view class="preview-wrap">
      <canvas id="planeCanvas" type="2d" class="plane-canvas" style="{{planeStyle}}"></canvas>
    </view>
  </view>

  <!-- 统计分析 -->
  <view wx:if="{{hasStats}}" class="panel">
    <view class="section-title">统计分析（LSB 隐写检测）</view>
    <view wx:for="{{statsChannels}}" wx:key="name" class="stats-channel">
      <view class="stats-head">
        <text class="stats-name">{{item.name}}</text>
        <text class="stats-verdict {{item.norm < 1.6 ? 'suspect' : ''}}">{{item.verdict}}</text>
      </view>
      <view class="stats-line">
        <text class="stats-label">低位 1 占比：</text>
        <text>{{item.ratioText}}%</text>
      </view>
      <view class="stats-line">
        <text class="stats-label">卡方归一：</text>
        <text>{{item.normText}} (df={{item.df}})</text>
      </view>
      <view class="stats-planes">
        <view wx:for="{{item.planeRatios}}" wx:for-item="ratio" wx:for-index="bit" wx:key="bit" class="plane-bar">
          <text class="plane-label">bit{{bit}}</text>
          <view class="plane-track">
            <view class="plane-fill" style="width:{{ratio.value * 100}}%"></view>
          </view>
          <text class="plane-pct">{{ratio.percent}}%</text>
        </view>
      </view>
    </view>
    <view class="mode-tip">卡方归一值 &lt; 1.6 高度疑似 LSB 隐写，&lt; 6 可疑。低位 1 占比接近 50% 说明该位接近随机噪声（天然或人为）。</view>
  </view>

  <view wx:if="{{statusText}}" class="status {{statusError ? 'error' : ''}}">{{statusText}}</view>

  <canvas id="workCanvas" type="2d" class="work-canvas"></canvas>
</view>
